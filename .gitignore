# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Dados processados são regenerados pelo pipeline
data/processed/*
!data/processed/.gitkeep

# Modelos: por padrão não se versiona artefato binário.
# Exceção deliberada: o Streamlit Community Cloud precisa do modelo no repositório
# para servir o dashboard, e ele tem poucos KB.
*.pkl
*.joblib
!models/modelo.joblib

# Artefatos de ablação e de outras variantes são resultado de experimento, não
# entrega. Só o par de produção (modelo.joblib + metricas.json) é versionado.
models/*_sem_total_charges.*

# Figuras: versionadas de propósito. São geradas por
# `python -m telco_churn.comparacao`, mas o README e o notebook as exibem, e um
# repositório que mostra gráficos quebrados até alguém rodar o pipeline não
# serve à leitura de 40 segundos.
!reports/figures/*.png

# OS / editor
.DS_Store
.vscode/
.idea/

# Env / secrets
.env
